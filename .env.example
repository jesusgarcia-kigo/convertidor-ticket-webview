# ============================================================
# KIGO — Convertidor de boleto (webview) · Variables de entorno
# ============================================================

# development | staging | production
VITE_APP_ENV=development

# true  = datos de prueba, sin llamadas de red (agrega ?mock=error para ver el error)
# false = llama al servicio real de conversión
VITE_ENABLE_MOCK_MODE=true

# Servicio real de conversión (fuente: singlecheck/conversion.php).
# En desarrollo, usa la ruta relativa para pasar por el proxy de Vite y evitar CORS:
#   VITE_CONVERSION_URL=/api/CAME/conversion.py
VITE_CONVERSION_URL=https://guest.geosek.info/api/CAME/conversion.py

# Timeout de la llamada en ms (el legado no tenía límite)
VITE_API_TIMEOUT=15000
